<Window x:Class="SmartJournal_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartJournal_UI"
        mc:Ignorable="d"
        Title="SmartJournal" Height="500" Width="800">
    <Grid>
        <TabControl x:Name="MainAppTabs" Margin="5">

            <TabItem x:Name="FeedTab" Header="📖 Стрічка записів">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBox Width="250" Padding="5" Text="Пошук за тегами..." Foreground="Gray" FontSize="14"/>
                        <Button Content="🔍 Знайти" Width="80" Margin="10,0,0,0" Background="#EEEEEE"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" FontSize="14">
                        <ListBoxItem Content="[28.04] Лекція по ТРМД - Паттерн MVVM..." Padding="10" FontWeight="Bold"/>
                        <ListBoxItem Content="[27.04] Ідеї для пет-проєкту - Зробити трекер води" Padding="10"/>
                        <ListBoxItem Content="[26.04] 📷 Фото з прогулянки (Мультимедіа)" Padding="10"/>
                    </ListBox>

                    <StackPanel x:Name="CommentPanel" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Text="💬 Залишити терапевтичний коментар для клієнта:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5" Foreground="#512BD4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Padding="8" FontSize="14" Text="Чудова динаміка! Рекомендую більше відпочивати на вихідних..."/>
                            <Button Grid.Column="1" Content="Надіслати" Width="120" Margin="10,0,0,0" Background="#512BD4" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="NewEntryTab" Header="✍️ Новий запис">
                <StackPanel Margin="20">
                    <TextBlock Text="Новий запис у щоденнику" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Твіт настрій сьогодні:" FontSize="14" Margin="0,0,0,5"/>
                    <ComboBox Margin="0,0,0,15" FontSize="14" Padding="5" SelectedIndex="0">
                        <ComboBoxItem Content="😊 Натхнення"/>
                        <ComboBoxItem Content="😌 Спокій"/>
                        <ComboBoxItem Content="😔 Сум"/>
                        <ComboBoxItem Content="😫 Стрес"/>
                    </ComboBox>
                    <TextBlock Text="Що сталося?" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox Height="150" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="📍 Геопозиція" Width="100" Height="30" Margin="0,0,10,0" Background="#EEEEEE"/>
                        <Button Content="📷 Додати photo" Width="100" Height="30" Margin="0,0,10,0" Background="#EEEEEE"/>
                        <Button Content="💾 Зберегти" Width="100" Height="30" Background="#512BD4" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="StatsTab" Header="📊 Статистика">
                <StackPanel Margin="20">
                    <TextBlock Text="Аналітика настрою за місяць" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="😊 Радість та Натхнення: 15 днів" FontSize="16" Foreground="Green" Margin="0,0,0,5"/>
                    <TextBlock Text="😌 Спокій: 10 днів" FontSize="16" Foreground="SteelBlue" Margin="0,0,0,5"/>
                    <TextBlock Text="😫 Стрес та Сум: 5 днів" FontSize="16" Foreground="Red" Margin="0,0,0,20"/>

                    <Button Content="📅 Відкрити календарний вигляд" Width="250" Height="35" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="⚙️ Налаштування">
                <StackPanel Margin="20">
                    <TextBlock Text="Налаштування додатку" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <CheckBox Content="Увімкнути Темну тему (Dark Mode)" FontSize="16" Margin="0,0,0,10"/>
                    <CheckBox Content="Великий шрифт тексту" FontSize="16" Margin="0,0,0,20"/>

                    <Button Content="☁️ Хмарна синхронізація" Width="220" Height="35" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                    <Button Content="📄 Експорт щоденника у PDF" Width="220" Height="35" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="TasksTab" Header="✅ Завдання">
                <StackPanel Margin="20">
                    <TextBlock Text="Мій To-Do список" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <CheckBox Content="Здати Лабу №5 (Дедлайн: сьогодні)" IsChecked="True" FontSize="16" Margin="0,0,0,10"/>
                    <CheckBox Content="Прибрати в кімнаті" FontSize="16" Margin="0,0,0,10"/>
                    <CheckBox Content="Прочитати 20 сторінок книги" FontSize="16" Margin="0,0,0,20"/>
                    <Button Content="➕ Додати нове завдання" Width="200" Height="35" Background="#EEEEEE" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="WaterTab" Header="💧 Вода">
                <Grid Margin="20">
                    <StackPanel x:Name="WaterSetupPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">
                        <TextBlock Text="Налаштування профілю" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ваш вік (років):" FontSize="14" Margin="0,0,0,5"/>
                        <TextBox x:Name="AgeInput" FontSize="16" Padding="5" Margin="0,0,0,15" Text="18"/>
                        <TextBlock Text="Ваш зріст (см):" FontSize="14" Margin="0,0,0,5"/>
                        <TextBox x:Name="HeightInput" FontSize="16" Padding="5" Margin="0,0,0,15" Text="175"/>
                        <TextBlock Text="Ваша вага (кг):" FontSize="14" Margin="0,0,0,5"/>
                        <TextBox x:Name="WeightInput" FontSize="16" Padding="5" Margin="0,0,0,20" Text="70"/>
                        <Button Content="Розрахувати норму" Height="40" Background="#512BD4" Foreground="White" FontSize="16" FontWeight="Bold" Click="CalculateWaterGoal_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="WaterTrackerPanel" HorizontalAlignment="Center" Width="300" Visibility="Collapsed">
                        <TextBlock Text="Водний баланс" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="WaterGoalText" Text="Випито: 0 / 2100 мл" FontSize="18" Foreground="#0078D7" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                        <ProgressBar Value="0" Width="250" Height="25" Margin="0,0,0,20"/>
                        <TextBlock Text="1. Оберіть напій:" FontSize="14" Margin="0,0,0,5"/>
                        <ComboBox x:Name="DrinkTypeSelector" FontSize="14" Padding="5" Margin="0,0,0,15" SelectedIndex="0">
                            <ComboBoxItem Content="💧 Вода"/>
                            <ComboBoxItem Content="🍵 Чай"/>
                            <ComboBoxItem Content="☕ Кава"/>
                            <ComboBoxItem Content="🥤 Кола"/>
                        </ComboBox>
                        <TextBlock Text="2. Оберіть об'єм:" FontSize="14" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <TextBlock Text="{Binding ElementName=WaterSlider, Path=Value}" FontSize="24" FontWeight="Bold" Foreground="#512BD4"/>
                            <TextBlock Text=" мл" FontSize="24" FontWeight="Bold" Foreground="#512BD4"/>
                        </StackPanel>
                        <Slider x:Name="WaterSlider" Minimum="0" Maximum="5000" Value="250" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,0,0,25"/>
                        <Button Content="➕ Додати запис" Height="40" Background="#512BD4" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <Grid x:Name="LockScreenGrid" Background="White">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🔒 SmartJournal" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#512BD4"/>
                <TextBlock Text="Система розмежування прав доступу" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="1. Оберіть вашу роль:" FontSize="14" Foreground="Black" Margin="0,0,0,5" FontWeight="Bold"/>
                <ComboBox x:Name="RoleSelector" Width="220" Height="35" FontSize="14" Margin="0,0,0,20" SelectedIndex="0">
                    <ComboBoxItem Content="✍️ Автор (Повний контроль)"/>
                    <ComboBoxItem Content="🧠 Психолог (Тільки перегляд)"/>
                </ComboBox>

                <TextBlock Text="2. Введіть PIN-код (1234):" FontSize="14" Foreground="Black" Margin="0,0,0,5" FontWeight="Bold"/>
                <PasswordBox x:Name="PinInput" Width="220" Height="35" FontSize="20" HorizontalContentAlignment="Center" Margin="0,0,0,25"/>

                <Button Content="Увійти в систему" Width="220" Height="45" Background="#512BD4" Foreground="White" FontSize="16" FontWeight="Bold" Click="LoginButton_Click"/>

                <TextBlock x:Name="ErrorMessage" Text="Невірний PIN-код! Спробуйте 1234" Foreground="Red" FontSize="14" HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Hidden"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>